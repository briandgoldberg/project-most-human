# Copy to .env.local. Everything here is optional for local play:
# with no settings the game runs in test mode with dev passwords.

# --- The AI judge -------------------------------------------------------------
# With a key, Claude reads the answers and judges alongside the behaviour model.
# Without one, scores come from behaviour alone.
ANTHROPIC_API_KEY=
# JUDGE_MODEL=claude-opus-5-5
# JUDGE_EFFORT=medium            # low | medium | high
# QUESTION_SOURCE=llm            # llm = the AI writes each player's questions live | bank = random from the built-in bank
# QUESTION_MODEL=                # model that writes questions and decoys; defaults to JUDGE_MODEL. A smaller model here is the biggest cost saving left.
# LLM_DAILY_TOKENS=0             # ceiling on Claude tokens per day; past it: question bank and behaviour judge only. 0 = none

# --- The owner page (/owner) -----------------------------------------------------
# Required in production: there is no default password there.
OWNER_PASSWORD=

# --- Google sign-in for the human side ---------------------------------------------
# A Google OAuth client id (type "Web application", with this site under "Authorised JavaScript origins").
# Set, players must sign in with Google. Unset, anyone can play.
# GOOGLE_CLIENT_ID=
# SESSION_SECRET=                # signs players' passes and scrambles their account ids; defaults to STORE_SECRET

# --- The game -----------------------------------------------------------------------
# HUNT_REPEATS=off               # on = a player may be shown real answers they have already judged (for testing)
# HUMAN_PRIZE_TOKENS=20          # what a player wins for being judged human
# HUNT_ROUND_PRIZES=20,40,60,80,120,160   # added for each hunting round cleared, in order
# PRIZES_PER_PERSON=0            # prizes one person may win a day; 0 = no limit
# HUMAN_GAMES_PER_ADDRESS=100    # games one network address may start a day; 0 = no limit
# AGENT_FEE_TOKENS=100           # what an agent pays per run
# AGENT_PRIZE_TOKENS=1000        # what an agent wins for fooling the judge
# AGENT_DAILY_CAP=500            # agent runs per day across all keys
# ENTRY_FEE_TOKENS=0             # what a player pays to play; 0 = free
# RETRAIN_EVERY=10               # the judge retrains itself after this many new labelled runs
# RETRAIN_AFTER_LOSSES=3         # ...or sooner, once agents have fooled it this many times since it last trained
# BAN_AFTER_STRIKES=3            # games ended for breaking the rules before an account is banned
# BOT_HUNTER=on                  # off removes the hunting rounds
# MINI_GAMES=                    # which mini-games are in play: any of draw,tap,hold,aim,beat,recall. Empty = all
# AGENT_KEY=                     # the house's own agent key, for `npm run bots`

# --- The coin -----------------------------------------------------------------------
PAYMENT_MODE=mock                # mock = play tokens, nothing real | solana = real SPL token transfers
# TOKEN_SYMBOL=TEST
# SOLANA_CLUSTER=devnet          # devnet | mainnet-beta
# SOLANA_RPC_URL=                # defaults to the public endpoint for the cluster; use a paid RPC on mainnet
# TOKEN_MINT=                    # mint address of the coin. Switching coins = changing this line.
# TREASURY_WALLET=               # public address that collects fees and pays prizes

# PAYOUT_HOUR_UTC=               # hour (0-23, UTC) the daily payout run starts; set it and players are told when their balance is sent.
#                                # Keep it equal to the schedule in .github/workflows/payouts.yml (17).
# PAYOUT_CAP_TOKENS=             # for `npm run prizes`: the most one run may send. Over it, nothing is sent.
# PAYOUT_REPOSITORY=             # "owner/name" of the GitHub repository whose payouts.yml may ask the website what is owed
# PAYOUT_REPOSITORY_ID=          # ...and GitHub's numeric ids for that repository and its owner, checked when set
# PAYOUT_REPOSITORY_OWNER_ID=

# Never put the treasury's private key here. `npm run prizes` asks for it separately.

# --- Storage ----------------------------------------------------------------------
# Unset = files under ./data (local play, or a server with a disk).
# On serverless hosts set all three; see supabase/migrations/0001_store.sql.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# STORE_SECRET=                  # long random string; only its hash is stored in the database

# --- Misc -------------------------------------------------------------------------
# SESSION_MINUTES=30
# PMH_DATA_DIR=./data
