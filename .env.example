# Copy to .env.local. Everything here is optional for local play:
# with no settings the game runs in test mode with dev passwords.

# --- The AI judge -------------------------------------------------------------
# With a key, Claude reads the answers and judges alongside the behaviour model.
# Without one, scores come from behaviour alone.
ANTHROPIC_API_KEY=
# JUDGE_MODEL=claude-opus-5-5
# JUDGE_EFFORT=medium            # low | medium | high
# QUESTION_SOURCE=llm            # llm = the AI writes each player's questions live | bank = random from the built-in bank
# QUESTION_MODEL=                # model that writes questions; defaults to JUDGE_MODEL. Players wait on it between questions.

# --- The training room (/train) -------------------------------------------------
# Required in production: there are no default passwords there.
OWNER_PASSWORD=                  # you alone: the training room, plus labelling players on the public board
TRAINING_PASSWORD=               # your friends; each session declares human or agent
HOUSE_BOT_PASSWORD=              # the house bots; always recorded as agent

# --- Entry fee and pool ---------------------------------------------------------
PAYMENT_MODE=mock                # mock = play tokens, nothing real | solana = real SPL token transfers
ENTRY_FEE_TOKENS=1000
# TOKEN_SYMBOL=TEST
# RAKE_BPS=0                     # house cut of the pool in basis points (500 = 5%)

# --- Solana (PAYMENT_MODE=solana) -----------------------------------------------
# SOLANA_CLUSTER=devnet          # devnet | mainnet-beta
# SOLANA_RPC_URL=                # defaults to the public endpoint for the cluster; use a paid RPC on mainnet
# TOKEN_MINT=                    # mint address of the coin. Switching coins = changing this line.
# TREASURY_WALLET=               # public address that collects fees and pays the winner

# Never put the treasury's private key here. `npm run payout` asks for it separately.

# --- The agent bounty (/agents) -----------------------------------------------------
# AGENT_BOUNTY_TOKENS=5000       # paid daily to the best agent the judge takes for human
# AGENT_ENTRIES_PER_KEY=5        # runs per builder key per day
# AGENT_DAILY_CAP=200            # agent runs per day across all keys; bounds the AI cost of a flood

# --- Storage ----------------------------------------------------------------------
# Unset = files under ./data (local play, or a server with a disk).
# On serverless hosts set all three; see supabase/migrations/0001_store.sql.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# STORE_SECRET=                  # long random string; only its hash is stored in the database

# --- Misc -------------------------------------------------------------------------
# SESSION_MINUTES=30
# PMH_DATA_DIR=./data
